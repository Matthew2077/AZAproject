                        },
                        axisTicks: {
                            show: false
                        },
                        crosshairs: {
                            fill: {
                            type: 'gradient',
                            gradient: {
                                colorFrom: '#D8E3F0',
                                colorTo: '#BED1E6',
                                stops: [0, 100],
                                opacityFrom: 0.4,
                                opacityTo: 0.5,
                            }
                            }
                        },
                        tooltip: {
                            enabled: true,
                        }
                        },
                        yaxis: {
                        axisBorder: {
                            show: false
                        },
                        axisTicks: {
                            show: false,
                        },
                        labels: {
                            show: false,
                            formatter: function (val) {
                            return val + "%";
                            }
                        }

                        },
                        title: {
                        text: 'Margine',
                        floating: true,
                        offsetY: 330,
                        align: 'center',
                        style: {
                            color: '#444'
                        }
                        }
                        };

                        var chart = new ApexCharts(document.querySelector("#" + id), options);
                    chart.render();
                break;

                case "IDQ":
                    var responseData = r.response;


                    var scarsoData = [];
                    var medioData = [];
                    var ottimoData = [];
                    var categories = [];
                    // trasforma la risposta in 4 diversi array poi usati nel grafico
                    for (var category in responseData) {
                        categories.push(category);
                        scarsoData.push(responseData[category].scarso || 0);
                        medioData.push(responseData[category].medio || 0);
                        ottimoData.push(responseData[category].ottimo || 0);
                    }

                    // Formatta i nomi delle categorie per renderli più leggibili
                    var formattedCategories = categories.map(function(cat) {
                        return cat.charAt(0).toUpperCase() + cat.slice(1).replace(/_/g, ' ');
                    });

                    var options = {
                        series: [{
                            name: 'Scarso',
                            data: scarsoData,
                            color: '#068EF8'
                        }, {
                            name: 'Medio',
                            data: medioData,
                            color: '#FFB6B3'
                        }, {
                            name: 'Ottimo',
                            data: ottimoData,
                            color: '#1ee811'
                        }],
                        chart: {
                            type: 'bar',
                            height: 350,  // Aumenta l'altezza per bilanciare la larghezza ridotta
                            width: '100%', // Usa il 100% del contenitore
                            stacked: true,
                            toolbar: {
                                show: true
                            },
                            zoom: {
                                enabled: true
                            }
                        },
                        plotOptions: {
                            bar: {
                                horizontal: false,
                                borderRadius: 4,
                                dataLabels: {
                                    total: {
                                        enabled: true,
                                        style: {
                                            fontSize: '13px',
                                            fontWeight: 900
                                        }
                                    }
                                }
                            }
                        },
                        xaxis: {
                            categories: formattedCategories,
                            labels: {
                                style: {
                                    fontSize: '12px',
                                    fontWeight: 'bold'
                                },
                                formatter: function(value) {
                                    return value.split(' ').map(function(word) {
                                        return word.charAt(0).toUpperCase() + word.slice(1);
                                    }).join(' ');
                                }
                            }
                        },
                        legend: {
                            position: 'right',
                            offsetY: 40
                        },
                        fill: {
                            opacity: 1
                        },
                        title: {
                            text: 'Analisi qualitativa prodotti (IDQ)',
                            align: 'center',
                            style: {
                                fontSize: '16px',
                                fontWeight: 'bold',
                                color: '#333'
                            }
                        },
                        tooltip: {
                            y: {
                                formatter: function(val) {
                                    return val;
                                }
                            }
                        }
                    };



                    var chart = new ApexCharts(document.querySelector("#" + id), options);
                    chart.render();
                break;



                        }

                    } else {
                        alert("ERROR: " + r.message);
