<script>

// trova il filename e lo mette a disposizione del ajax sottostante
var currentFileName = '';

// Update filename when file is selected
$('#json-upload').change(function() {
    currentFileName = $(this)[0].files[0] ? $(this)[0].files[0].name : '';
    $('#file-info').text(currentFileName || 'No file selected');
});


//GESTIONE upload file
$(document).ready(function() {
    // Gestione dell'upload del file
    $('#uploadForm').on('submit', function(e) {
        e.preventDefault();
        cleanExistingCharts();

        var formData = new FormData(this);

        $.ajax({
            url: 'upload.php',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function(response) {
                try {
                    // var data = JSON.parse(response);
                    var r = typeof response === 'string' ? JSON.parse(response) : response;
                    console.log("Risposta completa dal server:", r);


                     console.log("test file 4: " + currentFileName)
                    if(r && r.success) {
                        var countries = r.file_info?.countries || [];
                        var file_Name = r.filename || '';
                        var lastupdate = r.file_info?.last_update || '-';
                        var asin_count = r.file_info?.asin_count || 0;
                        var ean_count = r.file_info?.ean_count || 0;
                        var total_products = r.file_info?.total_products || 0;
                        var amazon_products = r.file_info?.amazon_products || 0;
                        
                        // Aggiorna l'interfaccia con i dati del file
                        $('#last-update').text(lastupdate);
                        $('#asin_count').text(asin_count);
                        $('#ean_count').text(ean_count);
                        $('#total_products').text(total_products);
                        $('#amazon_products').text(amazon_products);

                            // Genera dinamicamente le tab dei paesi
                            generateCountryTabs(countries, currentFileName, lastupdate, asin_count, ean_count, total_products, amazon_products)

                        // Mostra messaggio di successo
                        // alert('File caricato con successo!');
                        showToast("Azione utente", "Hai caricato il file con successo!"); //prima va scritto il titolo e poi il body



                    } else {
                        // alert('Errore: ' + data.message);
                        showToast("System", "Errore");
                    }
                } catch(e) {
                    // alert('Errore nel parsing della risposta');
                    showToast("System", "Errore nel parsing della risposta");
                }
            },
            error: function(xhr, status, error) {
                // alert('Errore durante il caricamento: ' + error);
                showToast("System", 'Errore durante il caricamento: ' + error);
            }
        });
    });

     // Mostra il nome del file selezionato
     $('#json-upload').change(function() {
         var fileName = $(this).val().split('\\').pop();
         $('#file-info').text(fileName || 'Nessun file selezionato');
     });

    // Gestione dei tab
    $('.tab-button').click(function() {
        showToast("Azione utente", "Caricamento grafici per il paese selezionato");
        $('.tab-button').removeClass('active');
        $(this).addClass('active');
        var tabId = $(this).data('tab');
        $('.tab-content').removeClass('active');
        $('#' + tabId).addClass('active');
    });


});


function generateCountryTabs(countries, currentFileName, lastupdate, asin_count, ean_count, total_products, amazon_products) {
    var $tabsContainer = $('#tabs-paesi');
    $tabsContainer.empty(); // Rimuovi le tab esistenti
    // Aggiungi le tab per ogni paese
    countries.forEach(function(country, index) {
        var isActive = index === 0 ? 'active' : '';
        var tabHtml = `
            <li class="nav-item">
                <a class="nav-link country ${isActive}" aria-current="page" country="${country}" href="#">${country}</a>
            </li>
        `;
        console.log(countries)
        $tabsContainer.append(tabHtml);
    });

    // Aggiungi il pulsante PDF dopo le tab dei paesi
    $tabsContainer.append(`
        <li class="nav-item">
            <button id="generaPDF" class="btn btn-danger btn-block">Genera PDF</button>
        </li>
    `);

}











$(document).on('click', '.country',function () {


          // Rimuovi la classe active da tutte le tab
          $('.country').removeClass('active');
        // Aggiungi la classe active solo alla tab cliccata
        $(this).addClass('active');

        const country = $(this).attr('country'); //country da tab attiva
        {
            var activecountry = country;
        }
        // nome file
        console.log("paese atti" + country)

        // cicla i div con classe dashboard mandando i KPI necessari per la richiesta
    	$('.dashboard').each(function() {
    	var div = $(this);
        var id = $(this).attr('id');
        var kpi = $(this).attr('KPI');
        var output = $(this).attr('output');
		var OFFERS = $(this).attr('OFFERS')
		var MARGINE = $(this).attr('MARGINE')
        var ASIN = $(this).attr('ASIN')
        var TEMPO_DI_CONSEGNA = $(this).attr('TEMPO_DI_CONSEGNA')
        var IDQ = $(this).attr('IDQ')
        var LISTA_TOP_X = $(this).attr('LISTA_TOP_X')

        var data = {};
        data['KPI'] = kpi;
        data['output'] = output;
		data['country'] = country;
		data['OFFERS'] = OFFERS;
        data['MARGINE'] = MARGINE;
        data['ASIN'] = ASIN;
        data['TEMPO_DI_CONSEGNA'] = TEMPO_DI_CONSEGNA;
        data['IDQ'] = IDQ;
        data['LISTA_TOP_X'] = LISTA_TOP_X;
        data['filename'] = currentFileName;


        // var spinner = $('<i class="spinner fa-duotone fa-solid fa-spinner fa-spin-pulse fa-2x"></i>');
        // $(this).html(spinner);


//CONNESIONE AL SERVER FLASK
    $.ajax({
      url: 'http://192.168.1.183:5000/api/AZA', //192.168.1.183 // 237
      type: 'POST',
      contentType: 'application/json',
      async: false,
      data: JSON.stringify(data), //in data ci sono i dati che mandi nel payload
      success: function(r) {

        if(r.status == 1) {
            $(this).find('.spinner').remove();
        //array di kay e values
		var labels = Object.keys(r.response); //contiene i nomi
		var series = Object.values(r.response); //contiene i numeri, valori

        //Costruzione grafici
        switch (kpi) {
                //GRAFICO A TORTA Is_AMZ
                case "is_AMZ":
                    var options = {
                        series: series,
                        chart: {
                            width: 380,
                            type: 'pie',
                        },
                        title: {
                            text: "Amazon Seller:",
                            align: 'center',
                            style: {
                                fontSize: '16px',
                                fontWeight: 'bold',
                                color: '#333'
                            }
                        },
                        labels: labels,
                        colors: ['#0edf8d', '#27b00e'], // Blu per "Yes", blu chiaro per "No"
                        dataLabels: {
                        enabled: true,
                        style: {
                            colors: ['#000000', '#000000'] // Testo nero per entrambe le etichette
                        },
                        dropShadow: { //toglie le ombre
                            enabled: false
                        },
                        formatter: function(val, opts) {
                            return opts.w.globals.series[opts.seriesIndex] + " (" + val.toFixed(1) + "%)";
                        },
                        style: {
                            colors: ['#FFFFFF'] // Colore del testo in basso (percentuale)
                        }
                    },
                        legend: {
