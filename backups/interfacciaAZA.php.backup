                    }]
                };

                    var chart = new ApexCharts(document.querySelector("#" + id), options);
                    chart.render();
                break;

                case "MARGINE":


                    var options = {
                        series: [{
                        name: 'Inflation',
                        data: series
                        }],
                        chart: {
                        height: 350,
                        type: 'bar',
                        },
                        plotOptions: {
                        bar: {
                            borderRadius: 10,
                            dataLabels: {
                            position: 'top', // top, center, bottom
                            },
                        }
